# Copy this file to `.env` and fill in your own values.
# Nothing in this file is a real secret — generate/obtain your own for every entry.

# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API with credentials
# (your frontend's dev and production URLs).
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Local MongoDB:          mongodb://127.0.0.1:27017/cinebook
# MongoDB Atlas (example): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cinebook
MONGODB_URI=mongodb://127.0.0.1:27017/cinebook

# ---- Auth / JWT ----
# Any long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a normal session lasts
JWT_EXPIRES_IN=1d
# How long a "remember me" session lasts
JWT_REMEMBER_EXPIRES_IN=30d
# Set to true once the API is served over HTTPS in production (makes the auth cookie Secure)
COOKIE_SECURE=false
# 'lax' for local dev / same-domain deploys. Use 'none' (with COOKIE_SECURE=true)
# if the frontend and API are on different domains in production.
COOKIE_SAME_SITE=lax

# ---- TMDB (movie data) ----
# Free key from https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "API Read Access Token" (starts with eyJ) works.
# Leave empty to run the app with its built-in demo movie catalogue only.
TMDB_API_KEY=
